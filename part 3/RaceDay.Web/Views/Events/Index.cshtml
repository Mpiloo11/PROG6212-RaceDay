@model List<RaceDay.Web.Models.Event>

@{
    ViewData["Title"] = "RaceDay Events";
    var role = Context.Session.GetString("Role");
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Upcoming RaceDay Events</h1>
            <p class="text-muted">
                Discover running events and get ready for race day!
            </p>
        </div>

        @if (role == "Organiser")
        {
            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="btn btn-primary">
                + Create Event
            </a>
        }
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h4 class="card-title">
                                @raceEvent.Name
                            </h4>

                            <p class="card-text">
                                @raceEvent.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMMM yyyy HH:mm")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @raceEvent.DistanceKm km
                            </p>

                            <p>
                                <strong>Event Type:</strong>
                                @raceEvent.EventType
                            </p>

                            @if (role == "Participant")
                            {
                                <a asp-controller="Participant"
                                   asp-action="Enrol"
                                   asp-route-id="@raceEvent.Id"
                                   class="btn btn-primary mt-2">
                                    Enrol Now
                                </a>
                            }

                            @if (role == "Organiser")
                            {
                                <div class="d-flex flex-wrap gap-2 mt-3">

                                    <a asp-controller="Organiser"
                                       asp-action="Enrolments"
                                       asp-route-id="@raceEvent.Id"
                                       class="btn btn-primary">
                                        View Enrolments
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="CaptureResult"
                                       asp-route-eventId="@raceEvent.Id"
                                       class="btn btn-success">
                                        Capture Results
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="EditEvent"
                                       asp-route-id="@raceEvent.Id"
                                       class="btn btn-warning">
                                        Edit
                                    </a>

                                    <form asp-controller="Organiser"
                                          asp-action="DeleteEvent"
                                          asp-route-id="@raceEvent.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">

                                        <a asp-controller="Organiser"
                                           asp-action="Categories"
                                           asp-route-eventId="@raceEvent.Id"
                                           class="btn btn-info">
                                            Manage Categories
                                        </a>

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger">
                                            Delete
                                        </button>
                                    </form>

                                </div>
                            }

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
