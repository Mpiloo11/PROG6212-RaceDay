@model List<RaceDay.Web.Models.Result>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2>My Race Results</h2>

    <p class="text-muted">
        View your finishing positions and race times.
    </p>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Finishing Position</th>
                        <th>Finish Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.Event</td>
                            <td>@result.Position</td>
                            <td>@result.FinishTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You do not have any race results yet.
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Dashboard"
       class="btn btn-secondary">
        Back to Dashboard
    </a>
</div>
