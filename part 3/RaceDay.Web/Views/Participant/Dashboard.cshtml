@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Participant Dashboard</h2>
        <p class="text-muted">
            Welcome, @ViewBag.ParticipantName!
            Manage your RaceDay participation below.
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Available Events</h5>
                    <p>Browse events and enrol in a race.</p>
                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Enrolments</h5>
                    <p>View the events you have enrolled in.</p>
                    <a asp-controller="Participant"
                       asp-action="MyEnrolments"
                       class="btn btn-primary">
                        View My Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Results</h5>
                    <p>View your race results.</p>
                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="btn btn-primary">
                        View My Results
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Profile</h5>
                    <p>View and update your profile information.</p>
                    <a asp-controller="Participant"
                       asp-action="Profile"
                       class="btn btn-primary">
                        My Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
