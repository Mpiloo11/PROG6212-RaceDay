@model RaceDay.Web.Models.EventFormViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">
    <h2>Edit Event</h2>
    <p>Update the details of this RaceDay event.</p>

    <form asp-action="EditEvent" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Event Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">Event Date</label>
            <input asp-for="EventDate" type="datetime-local"
                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                   class="form-control" />
            <span asp-validation-for="EventDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
            <input asp-for="DistanceKm" type="number" step="0.1"
                   class="form-control" />
            <span asp-validation-for="DistanceKm" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventTypeId" class="form-label">Event Type</label>
            <select asp-for="EventTypeId" class="form-select">
                <option value="0">-- Select Event Type --</option>
                @foreach (var type in Model.EventTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
            <span asp-validation-for="EventTypeId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-controller="Events" asp-action="Index"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
