@model RaceDay.Web.Models.CaptureResultViewModel

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">
    <h2>Event Enrolments</h2>

    <p class="text-muted">
        Participants registered for Event #@Model.EventId
    </p>

    @if (Model.Enrolments.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Enrolments)
                    {
                        <tr>
                            <td>@item.Participant</td>
                            <td>@item.Email</td>
                            <td>@item.Category</td>
                            <td>@item.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="CaptureResult"
       asp-route-eventId="@Model.EventId"
       class="btn btn-success">
        Capture Results
    </a>

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>
</div>
