@model RaceDay.Web.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4">

    <h2>Create Category</h2>
    <p class="text-muted">Add a category to a RaceDay event.</p>

    <form asp-action="CreateCategory" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Category Name
            </label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Description
            </label>
            <textarea asp-for="Description"
                      class="form-control"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RaceEventId" class="form-label">
                Select Event
            </label>

            <select asp-for="RaceEventId" class="form-select">
                <option value="0">-- Select an Event --</option>

                @foreach (var raceEvent in Model.Events)
                {
                    <option value="@raceEvent.Id">
                        @raceEvent.Name
                    </option>
                }
            </select>

            <span asp-validation-for="RaceEventId"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Create Category
        </button>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
