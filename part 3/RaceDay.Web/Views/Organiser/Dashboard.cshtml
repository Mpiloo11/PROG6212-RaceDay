@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h2>Organiser Dashboard</h2>

    <p class="text-muted">
        Welcome, @ViewBag.OrganiserName!
        Manage your RaceDay events below.
    </p>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Manage Events</h5>
                    <p>View and manage your RaceDay events.</p>
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-primary">View Events</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>View Enrolments</h5>
                    <p>View participants registered for your events.</p>
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-primary">View Enrolments</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Capture Results</h5>
                    <p>Record participant finishing times and positions.</p>
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-primary">Capture Results</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Event Categories</h5>
                    <p>View event categories.</p>
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-primary">View Categories</a>
                </div>
            </div>
        </div>

    </div>
</div>
